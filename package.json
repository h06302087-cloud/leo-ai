{
  "name": "leo-ai-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Workflow & App Builder Platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:emulator": "firebase emulators:start",
    "docker:up": "docker-compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker-compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^5.4.0"
  },
  "workspaces": [
    "frontend",
    "backend/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "node": "^26.7.0",
    "zod": "^4.4.3"
  }
}