# Development Environment Configuration
# Copy this file to .env and configure with your values

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=leo-ai-dev
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# AI/LLM Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Database Configuration
FIRESTORE_EMULATOR_HOST=localhost:8080
REDIS_URL=redis://localhost:6379

# Backend Service Ports
STUDIO_SERVICE_PORT=3001
WORKFLOW_ENGINE_PORT=3002
AI_AGENT_SERVICE_PORT=3003
INTEGRATION_SERVICE_PORT=3004
EXPORT_SERVICE_PORT=3005

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
WEBHOOK_SECRET=whsec_your_webhook_secret

# Python Sandbox Configuration
PYTHON_SANDBOX_TIMEOUT=30000
PYTHON_MAX_MEMORY=512m

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WORKFLOW_API=http://localhost:3002
NEXT_PUBLIC_AGENT_API=http://localhost:3003
